{
  "name": "@wafflebase/design-sandbox",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "description": "Wafflebase's own instance of the design editor: the @wafflebase/core token adapter and the Vite config that wires it up. Never published.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "dev": "vite",
    "verify:tokens": "node ./scripts/verify-tokens.mjs"
  },
  "dependencies": {
    "@wafflebase/design-editor": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  }
}
