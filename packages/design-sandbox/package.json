{
  "name": "@wafflebase/design-sandbox",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "description": "Wafflebase's own instance of the design editor: the @wafflebase/core token adapter and the Vite config that wires it up. Never published.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "predev": "pnpm --filter @wafflebase/design-editor build",
    "dev": "vite",
    "verify:tokens": "node ./scripts/verify-tokens.mjs",
    "verify:scenes": "node ./scripts/verify-scenes.mjs"
  },
  "dependencies": {
    "@wafflebase/design-editor": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.14.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.58.2",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  }
}
