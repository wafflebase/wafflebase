{
  "name": "@wafflebase/debug-report",
  "version": "0.6.4",
  "private": true,
  "license": "Apache-2.0",
  "description": "Framework-agnostic core for reporting a defect from the running screen",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "jsdom": "^28.0.0",
    "prettier": "^3.3.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@wafflebase/core": "workspace:*"
  }
}
