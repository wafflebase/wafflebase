{
  "name": "@wafflebase/debug-report",
  "version": "0.6.7",
  "private": true,
  "license": "Apache-2.0",
  "description": "Framework-agnostic core for reporting a defect from the running screen",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/ui/index.ts",
    "./plugin": "./src/plugin/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.217",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@wafflebase/core": "workspace:*"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.217",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
