# Frontend production build configuration — TEMPLATE, not a working config.
#
# `pnpm frontend build` runs `vite build`, which uses mode `production`, and
# Vite ranks `.env.production` ABOVE the localhost `.env` beside it. So
# whatever this file's real counterpart contains is what every production
# bundle addresses, and nothing about a wrong value fails loudly — a bad
# backend URL resolves and answers, it just is not yours.
#
# For that reason `packages/frontend/.env.production` is NOT committed (see
# `.gitignore`). A real production build must supply these values itself, one
# of two ways:
#
#   1. Environment variables on the build command. `VITE_`-prefixed variables
#      already in the environment outrank every `.env*` file, so this needs
#      nothing written to disk. This is what CI does — see the
#      "Install and Build" step in `.github/workflows/publish-ghpage.yml`,
#      which reads them from repository variables.
#
#        VITE_BACKEND_API_URL=https://api.example.com \
#        VITE_YORKIE_RPC_ADDR=https://yorkie.example.com \
#        VITE_YORKIE_PUBLIC_KEY=your_yorkie_public_key \
#        pnpm frontend build
#
#   2. Copy this file to `packages/frontend/.env.production.local` (gitignored,
#      and the last file Vite loads) or to `packages/frontend/.env.production`,
#      and fill it in. Beware `.env.local`, the intuitive filename: it ranks
#      BELOW `.env.production`.
#
# Verify a build before shipping it: the values below must be the only origins
# in the output. Both directions are worth checking — substitute your own host
# for `api.example.com`, and note the quotes, which keep a host containing a
# shell metacharacter from being reinterpreted:
#
#   # 1. Nobody else's origin is baked in. `api.wafflebase.io` is upstream's
#   #    own backend — it is what a checkout from before this file's real
#   #    counterpart was un-committed silently built against.
#   grep -rl 'api.wafflebase.io' packages/frontend/dist   # must print nothing
#
#   # 2. Yours actually is. An empty result here means the build silently fell
#   #    back to a relative URL rather than picking your value up.
#   grep -rl 'api.example.com' packages/frontend/dist     # must print something

# React Router basename (`App.tsx`). `/` unless the site is served from a
# subpath. Note there is no matching Vite `base`, so a subpath deployment needs
# more than this one variable.
VITE_FRONTEND_BASENAME=/

# REQUIRED. Public origin of your backend. Prefixed onto every backend call,
# including the "Sign in with GitHub" link and the notifications SSE stream.
VITE_BACKEND_API_URL=

# REQUIRED. The address BROWSERS reach Yorkie at. Not the same value as the
# backend's own `YORKIE_RPC_ADDR` unless both run on the same host.
VITE_YORKIE_RPC_ADDR=

# REQUIRED if your Yorkie project has a public key. Passed as the Yorkie client
# `apiKey`. This is a *public* key — it is not a secret, and it ships in the
# bundle — but it does identify a specific Yorkie project, so use your own.
VITE_YORKIE_PUBLIC_KEY=

# OPTIONAL, and leave it empty unless the Google Analytics property is yours.
# When set, `vite.config.ts` injects a gtag.js bootstrap at build time and your
# visitors' page views are reported to Google under that measurement ID. Empty
# is falsy, so the snippet is stripped and no request is made.
VITE_GA_ID=
