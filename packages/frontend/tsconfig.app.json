{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* `src` holds this package's component tests alongside the components,
       so `tsc` sees `toBeInTheDocument` / `toHaveTextContent` without
       jest-dom's matcher declarations and reported 22 phantom errors.
       Naming the package here pulls them in; measured 161 -> 139 errors
       with no new ones. (An earlier attempt that widened `include` to
       `tests` instead made it worse: 161 -> 262.) `vite/client` is
       unaffected — `src/vite-env.d.ts` pulls it in by triple-slash
       reference, which `types` does not gate. */
    "types": ["@testing-library/jest-dom"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Base URL */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
