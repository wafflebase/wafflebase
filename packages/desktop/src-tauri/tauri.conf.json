{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wafflebase",
  "version": "../package.json",
  "identifier": "io.wafflebase.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; form-action https: http:; frame-ancestors 'none'",
      "capabilities": ["local"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Productivity",
    "shortDescription": "Wafflebase",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDMkZDQzZEMzI4OUIwQTEKUldTaHNJa3liY3d2WENPTk1ETVFMWnhUdWtVL1FHc0NucVJIS2kzNTYxNlV3S1dneXdCblQrdC8K",
      "endpoints": [
        "https://github.com/wafflebase/wafflebase/releases/download/desktop-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
