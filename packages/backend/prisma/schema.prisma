model User {
  id    Int     @default(autoincrement()) @id
  authProvider  String
  username      String
  email String  @unique
  photo String?
  // When a provider last vouched for `email`. Null on every row created
  // before the strategies checked the provider's verification flag, which is
  // why a *cross-provider* sign-in refuses to merge into such a row (see
  // `UserService.findOrCreateUser`): the email is the shared identity, and an
  // unverified GitHub primary address could have squatted somebody else's.
  emailVerifiedAt DateTime?
  documents Document[]
  shareLinks ShareLink[]
  datasources DataSource[]
  bigquerySources BigQuerySource[]
  lakehouseSources LakehouseSource[]
  workspaceMembers  WorkspaceMember[]
  workspaceInvites  WorkspaceInvite[]
  apiKeys           ApiKey[]
  userDocStyles     UserDocStyles?
  folders Folder[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsActed    Notification[] @relation("NotificationActor")
  templateListings      TemplateListing[]
  templateReports       TemplateReport[]
  chatMemberships       ChatChannelMember[]
  chatMessages          ChatMessage[]
  webhooksCreated       Webhook[]
}

model UserDocStyles {
  userId    Int      @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  styles    Json
  updatedAt DateTime @updatedAt
}

model DataSource {
  id         String   @id @default(uuid())
  name       String
  host       String
  port       Int      @default(5432)
  database   String
  username   String
  password   String
  sslEnabled Boolean  @default(false)
  authorID   Int
  author     User     @relation(fields: [authorID], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model BigQuerySource {
  id          String   @id @default(uuid())
  name        String
  projectId   String
  dataset     String?
  location    String?
  // service-account JSON key, AES-256-GCM encrypted (reuse crypto.util.ts)
  credentials String
  // per-connection bytes-scanned ceiling; stored as BigInt (converted to
  // Number at the API boundary since values stay well under 2^53)
  maximumBytesBilled BigInt?
  authorID    Int
  author      User      @relation(fields: [authorID], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model LakehouseSource {
  id          String      @id @default(uuid())
  name        String
  format      String // "iceberg" | "delta"
  storage     String // "s3" | "s3-compatible" | "gcs" | "azure" | "local"
  endpoint    String? // custom endpoint (MinIO/R2/GCS-interop)
  region      String?
  bucket      String?
  basePath    String? // table root or metadata path (direct-metadata mode)
  catalogMode CatalogMode @default(direct_metadata)
  catalogUri  String?
  // Credentials, AES-256-GCM encrypted (one packed JSON blob). Optional only
  // because the blob is written in a second step after the row is created
  // (matching the datasource create→test→save flow); a saved, usable
  // connection always has credentials.
  credentials String?
  authorID    Int
  author      User        @relation(fields: [authorID], references: [id])
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([workspaceId, name])
}

enum CatalogMode {
  direct_metadata
  rest_catalog
  s3_tables
  unity
}

model Document {
  id        String   @default(uuid()) @id
  title     String
  type      String   @default("sheet")
  fileId    String?
  // Blob metadata for file-backed documents (pdf/image/file); null for the
  // CRDT types. `fileSize` is also what a future workspace storage quota
  // would SUM — see docs/design/generic-file-upload.md.
  fileSize  Int?
  mimeType  String?
  authorID  Int?
  author    User?    @relation(fields: [authorID], references: [id])
  createdAt DateTime @default(now())
  // Last-modified time. Set explicitly from Yorkie's `DocumentRootChanged`
  // event webhook (see document/yorkie-event.controller.ts) — NOT Prisma's
  // `@updatedAt`, since content edits never pass through this backend. Used
  // to order the documents list; defaults to creation time until the first
  // edit webhook arrives.
  updatedAt DateTime @default(now())
  shareLinks ShareLink[]
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  notifications Notification[]
  templateListing TemplateListing?
  webhookContentPending WebhookContentPending?
  chatRefs  ChatDocumentRef[]

  // Trash. Null = live; set = moved to the trash at that time. A trashed
  // document is invisible everywhere a live one is visible — reads go through
  // `LIVE_DOCUMENT` / `DocumentService`, see docs/design/document-trash.md.
  // Restoring clears it; a permanent delete removes the row.
  deletedAt DateTime?

  @@index([workspaceId, folderId])
  @@index([workspaceId, deletedAt])
}

model Folder {
  id          String     @id @default(uuid())
  name        String
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]   @relation("FolderTree")
  documents   Document[]
  authorID    Int?
  author      User?      @relation(fields: [authorID], references: [id])
  createdAt   DateTime   @default(now())

  @@index([workspaceId, parentId])
}

model ShareLink {
  id         String    @id @default(uuid())
  token      String    @unique @default(uuid())
  role       String    @default("viewer")
  documentId String
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy  Int
  creator    User      @relation(fields: [createdBy], references: [id])
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  // Set when this link is the non-expiring `viewer` link a template listing
  // mints for its preview. Revoking it degrades the listing to a
  // thumbnail-only card (see TemplateListing.shareLinkId) rather than
  // breaking it.
  templateListing TemplateListing?
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  members     WorkspaceMember[]
  documents   Document[]
  invites     WorkspaceInvite[]
  datasources DataSource[]
  bigquerySources BigQuerySource[]
  lakehouseSources LakehouseSource[]
  apiKeys     ApiKey[]
  folders     Folder[]
  notifications Notification[]
  templateListings TemplateListing[]
  claim       WorkspaceClaim?
  chatChannels ChatChannel[]
  webhooks     Webhook[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  role        String
  joinedAt    DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

/// A workspace waiting for a person who has no Wafflebase account yet.
///
/// Migrated CodePair workspaces belong to people we can identify only by
/// their GitHub account id — CodePair never stored an email, and email is
/// what a Wafflebase account is keyed on, so no `User` row can be made for
/// them ahead of time. The workspace is created without an owner and this
/// row names who it is for; their first GitHub sign-in makes them its owner.
/// `githubId` is GitHub's numeric account id, which survives a rename of the
/// login.
model WorkspaceClaim {
  id          String    @id @default(uuid())
  githubId    String
  source      String    @default("codepair")
  createdAt   DateTime  @default(now())
  claimedAt   DateTime?
  claimedBy   Int?

  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([githubId])
}

model WorkspaceInvite {
  id          String    @id @default(uuid())
  token       String    @unique @default(uuid())
  role        String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   Int
  creator     User      @relation(fields: [createdBy], references: [id])
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  prefix      String
  hashedKey   String    @unique
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   Int
  creator     User      @relation(fields: [createdBy], references: [id])
  scopes      String[]  @default(["read", "write"])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

/// An in-app notification addressed at one user. See
/// `docs/design/notifications.md`.
///
/// Comment events are reported by the client (comments live inside Yorkie
/// CRDT documents and never reach this backend) and authorized here;
/// `workspace_member_joined` is created server-side in `acceptInvite`.
model Notification {
  id          String    @id @default(uuid())
  /// comment_mention | comment_reply | thread_resolved |
  /// workspace_member_joined | template_approved | template_rejected |
  /// template_removed | template_needs_review | template_review_queued |
  /// chat_mention | chat_thread_reply | webhook_failing | webhook_disabled
  type        String

  recipientId Int
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  /// Null once the acting user is deleted — the notification survives them.
  actorId     Int?
  actor       User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Cascades so a deleted document never leaves a dead link in the dropdown.
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Opaque CRDT identifiers. No foreign key — the backend stores them for
  /// the client and never resolves them.
  threadId    String?
  commentId   String?
  /// The comment id, or `<threadId>:resolved`. Separate from `commentId`
  /// because `thread_resolved` has no comment of its own, and null for
  /// `workspace_member_joined` (Postgres treats NULLs as distinct, so
  /// re-joining a workspace correctly notifies again).
  dedupeKey   String?
  /// Plain-text excerpt, <= 200 chars, control characters stripped.
  preview     String?

  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@unique([recipientId, type, dedupeKey])
  @@index([recipientId, createdAt])
  /// The badge query (`recipientId` + `readAt IS NULL`) runs on every stream
  /// connect, poll tick, publish, and mark-read. Without this it scans every
  /// row the user has ever received, read ones included.
  @@index([recipientId, readAt])
}

/// A document published as a template — see docs/design/template-gallery.md.
///
/// A template is deliberately NOT a `Document.type`: that column routes which
/// editor opens a document, and a template must open in the editor of whatever
/// it is a template *of*. So the listing is a sidecar row and "publish" is an
/// upsert on `documentId`, which is why that column is unique.
model TemplateListing {
  id          String    @id @default(uuid())

  /// The document this listing publishes. Cascades, so a deleted document
  /// takes its listing with it and never leaves a dead card in the gallery.
  documentId  String    @unique
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// The publishing workspace, denormalized so the workspace-tier gallery
  /// query does not have to join. Read authorization deliberately does NOT
  /// use it — that follows `document.workspaceId`, so moving a document out of
  /// a workspace stops that workspace reading it through the listing.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   Int
  creator     User      @relation(fields: [createdBy], references: [id])

  /// The non-expiring `viewer` share link minted at publish, which is what
  /// lets an anonymous visitor preview the template through the existing
  /// `/shared/:token` machinery (and what the Yorkie auth webhook honours in
  /// enforce mode). `SetNull`: a manager revoking it from the Share dialog
  /// degrades the listing to a thumbnail-only card, and re-publishing mints a
  /// new one — it must not delete the listing.
  shareLinkId String?    @unique
  shareLink   ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)

  /// Gallery metadata. `title` is seeded from the document title but is
  /// independently editable: a template is named for what it is *for*.
  title       String
  description String?
  category    String?
  tags        String[]
  /// Key in the image bucket (`GET /images/:id`), which is unauthenticated and
  /// immutably cached — so a gallery card renders for a logged-out visitor
  /// with no extra serving path.
  thumbnailId String?

  /// unlisted (link only) | workspace | public
  visibility  String    @default("unlisted")
  /// listed | pending | rejected | removed.
  ///
  /// The review state, kept deliberately separate from `visibility`, which
  /// stays the *effective* tier throughout. Submitting for public review moves
  /// only this column, so an already-handed-out unlisted link neither breaks
  /// nor silently widens while a reviewer looks at it; `visibility` becomes
  /// `public` only on approval.
  ///
  /// `rejected` and `removed` are not the same verdict. A rejection says the
  /// submission missed the gallery's bar and leaves the listing working at the
  /// tier it already had — the publisher may revise and resubmit. A takedown
  /// (`removed`) says the content may not be served at all: every non-manager
  /// read is refused, the preview link is revoked, and the row is **terminal**
  /// — it cannot be resubmitted, republished, edited or even unpublished,
  /// because deleting it would let the next publish mint a fresh anonymous
  /// link to the content that was removed. One state cannot carry both.
  status      String    @default("listed")
  /// When the publisher submitted for public review. Null until they do.
  submittedAt DateTime?
  /// When this listing's document last had a real content edit, as reported by
  /// Yorkie's `DocumentRootChanged` webhook. Deliberately not `updatedAt` on
  /// the document, which a rename also moves.
  contentChangedAt DateTime?
  /// The `contentChangedAt` a reviewer attested to when they approved.
  ///
  /// The pair is what makes an approval about *content* rather than about a
  /// row: a listing is publicly visible only while `contentChangedAt` has not
  /// moved past it. That keeps the gallery correct even if the event webhook
  /// is never registered or its write fails — the read path re-checks rather
  /// than trusting a status somebody remembered to write.
  reviewedContentAt DateTime?
  /// When a reviewer decided, who decided, and what they said. `reviewNote`
  /// becomes the rejection reason the publisher is notified with — a
  /// submission that disappears silently is the failure mode this pipeline
  /// exists to avoid.
  reviewedAt  DateTime?
  reviewedBy  Int?
  reviewNote  String?
  /// Incremented on each successful use. A counter, not a ledger: an
  /// occasional lost increment is acceptable, and it is what a future creator
  /// program would rank and pay on.
  useCount    Int       @default(0)
  /// When the publisher granted the license that lets others copy and modify
  /// the content. Required before a listing may go `public`.
  licensedAt  DateTime?
  /// The publisher's original, once `documentId` points at the frozen copy a
  /// public listing is promoted to at approval time. Null for the unlisted and
  /// workspace tiers, which track the live document as Canva's template links
  /// do.
  originId    String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// The public gallery's browse query: filter by tier+status, rank by usage.
  @@index([visibility, status, useCount])
  /// The same query under `sort=recent`, which orders by `publishedAt` and so
  /// cannot use the index above — without this one it sorts the whole tier.
  @@index([visibility, status, publishedAt])
  /// The workspace gallery's query.
  @@index([workspaceId, visibility])
  reports     TemplateReport[]
}

/// Someone flagging a listing for a reviewer — see
/// docs/design/template-gallery.md.
///
/// A takedown is a *reviewer* decision and always was; this is only the intake
/// that tells them there is something to look at. It exists because a public
/// gallery with no reported-content path has no remedy at all: the only people
/// who can act are the ones who never see the problem.
model TemplateReport {
  id         String          @id @default(uuid())
  listingId  String
  listing    TemplateListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /// Who reported it. Authenticated, so a report is attributable and the
  /// per-reporter unique index below can exist at all.
  reporterId Int
  reporter   User            @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  /// copyright | inappropriate | broken | spam | other
  reason     String
  note       String?
  /// open | dismissed | actioned. A reviewer closes a report; nothing deletes
  /// one, so the queue keeps its own history.
  status     String          @default("open")
  /// Who closed it and when. A queue that keeps its history without recording
  /// who acted keeps no history worth having.
  resolvedBy Int?
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())

  /// One report per person per listing. Not a nicety: without it a single
  /// account can stack a queue deep enough that the real reports are not
  /// findable, which is a denial of the reviewer's attention.
  @@unique([listingId, reporterId])
  /// The reviewer queue's own query: open reports, oldest first.
  @@index([status, createdAt])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// A workspace chat conversation: a public or private channel, or a DM.
/// See `docs/design/chat.md`.
model ChatChannel {
  id            String    @id @default(uuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// public | private | dm
  kind          String
  /// Null for a DM, which is labelled by its members.
  name          String?
  topic         String?
  createdBy     Int?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  /// The last allocated `ChatMessage.seq`. Bumped under the row lock inside
  /// the insert transaction, so ordering is total per channel and never
  /// depends on a replica's clock.
  lastSeq       BigInt    @default(0)
  /// DM only: `<workspaceId>:<sorted member ids>`. The unique index is what
  /// makes two people opening the same DM at once land in one channel.
  dmKey         String?   @unique
  /// The workspace's default channel (#general) carries its `workspaceId`
  /// here; null on every other channel. Unique, so a workspace has at most
  /// one. Every member belongs to it, and it cannot be left or archived.
  defaultKey    String?   @unique
  lastMessageAt DateTime?
  members       ChatChannelMember[]
  messages      ChatMessage[]

  @@unique([workspaceId, name])
  @@index([workspaceId, kind])
}

model ChatChannelMember {
  channelId   String
  channel     ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Unread = top-level messages with `seq` above this.
  lastReadSeq BigInt      @default(0)
  joinedAt    DateTime    @default(now())

  @@id([channelId, userId])
  @@index([userId])
}

model ChatMessage {
  id            String      @id @default(uuid())
  channelId     String
  channel       ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// Per-channel monotonic; the pagination and "after" cursor.
  seq           BigInt
  /// Null once the author is deleted — the message survives them.
  authorId      Int?
  author        User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Set when posted with an API key.
  apiKeyId      String?
  /// Plain text; mentions as `@[username](userId)`. Cleared on soft delete.
  body          String
  /// Null = top-level.
  threadRootId  String?
  alsoInChannel Boolean     @default(false)
  replyCount    Int         @default(0)
  lastReplyAt   DateTime?
  editedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  refs          ChatDocumentRef[]
  /// The poster's own id for this send. A retry carrying the same one gets
  /// the message back instead of a second copy.
  clientId      String?

  @@unique([channelId, seq])
  @@unique([channelId, authorId, clientId])
  @@index([threadRootId, seq])
  @@index([channelId, threadRootId, seq])
}

/// A document card: a Wafflebase document URL in a message body that names a
/// live document of the channel's workspace. Written on post and edit from
/// the body, cleared on delete. Title and type are read from the document at
/// read time, so a rename shows and a trashed document drops out.
/// `channelId` is denormalized off the message so the channel's Files list is
/// one index range. See `docs/design/chat.md` § Document Cards and Anchors.
model ChatDocumentRef {
  messageId  String
  message    ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  documentId String
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  channelId  String
  /// The parsed `?at=` anchor, or null for a document-level link.
  anchor     Json?
  createdAt  DateTime    @default(now())

  @@id([messageId, documentId])
  @@index([documentId, createdAt])
  @@index([channelId, createdAt])
}

/// Owner-managed outbound subscription for one workspace. Disabled, never
/// deleted, on failure. See `docs/design/webhooks.md`.
model Webhook {
  id                  String            @id @default(uuid())
  workspaceId         String
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Null once the creating user is deleted. Re-enabling records the owner
  /// who did it here, which is how a remaining owner takes a webhook over.
  createdBy           Int?
  creator             User?             @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  name                String
  url                 String
  /// standard
  format              String            @default("standard")
  /// Event types; empty = all.
  events              String[]
  /// Document types; empty = all. Only applied to events about a document.
  documentTypes       String[]
  /// Folder ids; empty = all. Matches a document whose `folderId` is listed.
  folderIds           String[]
  /// AES-256-GCM, see `webhook-secret.ts`. Must be decryptable to sign.
  secretEnc           String
  /// The secret being rotated out, still signed with until it expires.
  prevSecretEnc       String?
  prevSecretExpiresAt DateTime?
  /// active | disabled
  status              String            @default("active")
  disabledAt          DateTime?
  /// failing | gone | creator_removed | manual
  disabledReason      String?
  /// Set by a disable: the creation time of the oldest row it stopped, or
  /// `disabledAt` when it stopped none. The default "recover since", so
  /// re-enabling re-sends exactly what the disable cut off.
  recoverFrom         DateTime?
  /// First failure of the current unbroken failure streak; cleared on a
  /// success. Drives the warning and the auto-disable.
  failingSince        DateTime?
  /// When `webhook_failing` was sent for the current streak.
  warnedAt            DateTime?
  lastDeliveryAt      DateTime?
  lastDeliveryStatus  Int?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deliveries          WebhookDelivery[]

  @@index([workspaceId])
}

/// Outbox: one row per (webhook, event). `id` is the `webhook-id` header and
/// is reused by every retry and manual redeliver.
model WebhookDelivery {
  id              String    @id @default(uuid())
  webhookId       String
  webhook         Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventType       String
  /// The envelope body: `{ type, timestamp, data }`.
  payload         Json
  /// pending | in_flight | delivered | failed
  status          String    @default("pending")
  attempts        Int       @default(0)
  nextAttemptAt   DateTime  @default(now())
  /// While `in_flight`; an expired lease returns the row to `pending`.
  leaseUntil      DateTime?
  lastStatus      Int?
  lastError       String?
  lastDurationMs  Int?
  /// First 1 KB of the last response body.
  responseExcerpt String?
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
  /// The claim's per-webhook pick and in-flight count.
  @@index([webhookId, status, nextAttemptAt])
}

/// Coalescing state for `document.content_updated`: one row per document
/// however many webhooks subscribe. Upserted by the Yorkie event webhook,
/// flushed by the delivery worker once quiet or past the max wait.
model WebhookContentPending {
  documentId   String   @id
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspaceId  String
  firstSeenAt  DateTime @default(now())
  lastIssuedAt DateTime @default(now())
  /// `[{ api_key_id, user_id, at }]` — `/api/v1` writes inside the window.
  apiWriters   Json     @default("[]")
}
