model User {
  id    Int     @default(autoincrement()) @id
  authProvider  String
  username      String
  email String  @unique
  photo String?
  documents Document[]
  shareLinks ShareLink[]
  datasources DataSource[]
  bigquerySources BigQuerySource[]
  lakehouseSources LakehouseSource[]
  workspaceMembers  WorkspaceMember[]
  workspaceInvites  WorkspaceInvite[]
  apiKeys           ApiKey[]
  userDocStyles     UserDocStyles?
  folders Folder[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsActed    Notification[] @relation("NotificationActor")
}

model UserDocStyles {
  userId    Int      @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  styles    Json
  updatedAt DateTime @updatedAt
}

model DataSource {
  id         String   @id @default(uuid())
  name       String
  host       String
  port       Int      @default(5432)
  database   String
  username   String
  password   String
  sslEnabled Boolean  @default(false)
  authorID   Int
  author     User     @relation(fields: [authorID], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model BigQuerySource {
  id          String   @id @default(uuid())
  name        String
  projectId   String
  dataset     String?
  location    String?
  // service-account JSON key, AES-256-GCM encrypted (reuse crypto.util.ts)
  credentials String
  // per-connection bytes-scanned ceiling; stored as BigInt (converted to
  // Number at the API boundary since values stay well under 2^53)
  maximumBytesBilled BigInt?
  authorID    Int
  author      User      @relation(fields: [authorID], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model LakehouseSource {
  id          String      @id @default(uuid())
  name        String
  format      String // "iceberg" | "delta"
  storage     String // "s3" | "s3-compatible" | "gcs" | "azure" | "local"
  endpoint    String? // custom endpoint (MinIO/R2/GCS-interop)
  region      String?
  bucket      String?
  basePath    String? // table root or metadata path (direct-metadata mode)
  catalogMode CatalogMode @default(direct_metadata)
  catalogUri  String?
  // Credentials, AES-256-GCM encrypted (one packed JSON blob). Optional only
  // because the blob is written in a second step after the row is created
  // (matching the datasource create→test→save flow); a saved, usable
  // connection always has credentials.
  credentials String?
  authorID    Int
  author      User        @relation(fields: [authorID], references: [id])
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([workspaceId, name])
}

enum CatalogMode {
  direct_metadata
  rest_catalog
  s3_tables
  unity
}

model Document {
  id        String   @default(uuid()) @id
  title     String
  type      String   @default("sheet")
  fileId    String?
  // Blob metadata for file-backed documents (pdf/image/file); null for the
  // CRDT types. `fileSize` is also what a future workspace storage quota
  // would SUM — see docs/design/generic-file-upload.md.
  fileSize  Int?
  mimeType  String?
  authorID  Int?
  author    User?    @relation(fields: [authorID], references: [id])
  createdAt DateTime @default(now())
  // Last-modified time. Set explicitly from Yorkie's `DocumentRootChanged`
  // event webhook (see document/yorkie-event.controller.ts) — NOT Prisma's
  // `@updatedAt`, since content edits never pass through this backend. Used
  // to order the documents list; defaults to creation time until the first
  // edit webhook arrives.
  updatedAt DateTime @default(now())
  shareLinks ShareLink[]
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  notifications Notification[]

  @@index([workspaceId, folderId])
}

model Folder {
  id          String     @id @default(uuid())
  name        String
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]   @relation("FolderTree")
  documents   Document[]
  authorID    Int?
  author      User?      @relation(fields: [authorID], references: [id])
  createdAt   DateTime   @default(now())

  @@index([workspaceId, parentId])
}

model ShareLink {
  id         String    @id @default(uuid())
  token      String    @unique @default(uuid())
  role       String    @default("viewer")
  documentId String
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy  Int
  creator    User      @relation(fields: [createdBy], references: [id])
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  members     WorkspaceMember[]
  documents   Document[]
  invites     WorkspaceInvite[]
  datasources DataSource[]
  bigquerySources BigQuerySource[]
  lakehouseSources LakehouseSource[]
  apiKeys     ApiKey[]
  folders     Folder[]
  notifications Notification[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  role        String
  joinedAt    DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model WorkspaceInvite {
  id          String    @id @default(uuid())
  token       String    @unique @default(uuid())
  role        String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   Int
  creator     User      @relation(fields: [createdBy], references: [id])
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  prefix      String
  hashedKey   String    @unique
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   Int
  creator     User      @relation(fields: [createdBy], references: [id])
  scopes      String[]  @default(["read", "write"])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

/// An in-app notification addressed at one user. See
/// `docs/design/notifications.md`.
///
/// Comment events are reported by the client (comments live inside Yorkie
/// CRDT documents and never reach this backend) and authorized here;
/// `workspace_member_joined` is created server-side in `acceptInvite`.
model Notification {
  id          String    @id @default(uuid())
  /// comment_mention | comment_reply | thread_resolved | workspace_member_joined
  type        String

  recipientId Int
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  /// Null once the acting user is deleted — the notification survives them.
  actorId     Int?
  actor       User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Cascades so a deleted document never leaves a dead link in the dropdown.
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Opaque CRDT identifiers. No foreign key — the backend stores them for
  /// the client and never resolves them.
  threadId    String?
  commentId   String?
  /// The comment id, or `<threadId>:resolved`. Separate from `commentId`
  /// because `thread_resolved` has no comment of its own, and null for
  /// `workspace_member_joined` (Postgres treats NULLs as distinct, so
  /// re-joining a workspace correctly notifies again).
  dedupeKey   String?
  /// Plain-text excerpt, <= 200 chars, control characters stripped.
  preview     String?

  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@unique([recipientId, type, dedupeKey])
  @@index([recipientId, createdAt])
  /// The badge query (`recipientId` + `readAt IS NULL`) runs on every stream
  /// connect, poll tick, publish, and mark-read. Without this it scans every
  /// row the user has ever received, read ones included.
  @@index([recipientId, readAt])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
