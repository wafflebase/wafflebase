APPLY WITH: git apply docs/tasks/active/20260825-promote-exit-code-default-trigger-shape.patch

WHY THIS IS A PATCH AND NOT A COMMIT. The agent App that writes this branch
cannot push `.github/workflows/**` — GitHub rejects the push outright
("refusing to allow a GitHub App to create or update workflow ... without
`workflows` permission"). That is the same boundary mark-ready.mjs's gate 1b
comment describes, and it is why the workflow-side commits on this branch carry
a maintainer as their author. So the change is staged here for a human to apply
and push, exactly as the promote job's exit-code `case` was on this same branch.

WHAT IT DOES (review-panel finding, correctness/major). The three `if:` clauses
that now read `github.event.workflow_run.path` all gate by SKIPPING, on a
payload field nothing in this repo read before. If GitHub ever stops populating
it, the panel, the fixer and the CI report go quiet together and a skipped job
is a green job — the pipeline would be off with nothing to notice. The
`trigger-shape` job fires on exactly the payloads the gate refuses on path
grounds (empty, or another file) and exits 1, so that silence becomes a red run.
The checks.test.mjs hunk pins it: the canary must fire on an empty path and on
`pwn.yml`, must not fire for a real CI run on any action/attempt, and its body
must exit non-zero.

BOTH HUNKS LAND TOGETHER. The test asserts the job exists, so applying only the
test reds CI, and applying only the job leaves it unpinned. Delete this file in
the same commit that applies it.

diff --git a/.github/workflows/agent-review-panel.yml b/.github/workflows/agent-review-panel.yml
index 5340ac58a..bb2767988 100644
--- a/.github/workflows/agent-review-panel.yml
+++ b/.github/workflows/agent-review-panel.yml
@@ -138,6 +138,60 @@ env:
   MAX_REVIEW_ROUNDS: "3"
 
 jobs:
+  # PAYLOAD CANARY — the one thing the `path` clauses cannot check about
+  # themselves.
+  #
+  # Three workflows now gate on `github.event.workflow_run.path` (this file, and
+  # the `if:`s in agent-iterate-ci.yml and ci-report.yml), and every one of them
+  # gates by SKIPPING. That field was not read anywhere in this repo before, and
+  # nothing validates it: if GitHub ever stops populating it, or renames it, all
+  # three clauses evaluate false for EVERY CI run and the whole agent pipeline —
+  # panel, fixer, CI report — goes quiet. A skipped job is a green job, so the
+  # failure would look exactly like a repo where no agent PRs are open.
+  #
+  # This job fires on precisely the events the `gate` below refuses on path
+  # grounds, and it FAILS, so "the pipeline stopped running" is a red run in the
+  # Actions tab instead of silence. Two distinguishable causes, both worth a
+  # human:
+  #
+  #   path empty/absent   → the payload changed shape; every path clause in
+  #                         .github/workflows is now permanently false. They
+  #                         have to be fixed together, which is why one canary
+  #                         covers all three files rather than one canary each.
+  #   path is some other  → a second workflow file is calling itself `name: CI`
+  #   file                  (the trigger's `workflows:` filter matches display
+  #                         names). Accident or forgery, it is the case the
+  #                         clause was added to refuse.
+  #
+  # Same-repo heads only, matching `gate`: a fork's CI run can never drive this
+  # pipeline, so it is not worth a red run — and this repo is PUBLIC, so any
+  # fork could otherwise redden it at will.
+  trigger-shape:
+    if: >-
+      vars.AGENT_PIPELINE_ENABLED == 'true' &&
+      github.event.workflow_run.head_repository.full_name == github.repository &&
+      github.event.workflow_run.path != '.github/workflows/ci.yml'
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - name: Report the refused trigger payload
+        env:
+          WF_PATH: ${{ github.event.workflow_run.path }}
+          WF_NAME: ${{ github.event.workflow_run.name }}
+          WF_URL: ${{ github.event.workflow_run.html_url }}
+        run: |
+          if [ -z "$WF_PATH" ]; then
+            echo "::error::workflow_run.path is EMPTY for a run named '$WF_NAME' ($WF_URL)."
+            echo "Every path gate in .github/workflows — agent-review-panel, agent-iterate-ci," >&2
+            echo "ci-report — is now false for every CI run, so the agent pipeline is DISABLED." >&2
+            echo "Fix them together; do not delete this canary to make the run green." >&2
+          else
+            echo "::error::A run named '$WF_NAME' came from '$WF_PATH', not .github/workflows/ci.yml ($WF_URL)."
+            echo "A second workflow file is claiming CI's display name. The pipeline refused it," >&2
+            echo "which is correct — this job exists so the refusal is visible rather than silent." >&2
+          fi
+          exit 1
+
   # Is this PR agent-managed? Either an autonomous `agent/` branch, OR a human PR
   # opted in via the `agent:managed` label ("@claude loop"). workflow_run payloads
   # carry no PR labels, so we resolve the PR and read them here rather than in a
diff --git a/scripts/agent/checks.test.mjs b/scripts/agent/checks.test.mjs
index 108157aa9..be8926fa8 100644
--- a/scripts/agent/checks.test.mjs
+++ b/scripts/agent/checks.test.mjs
@@ -216,6 +216,24 @@ test("the panel starts with CI, admits re-runs, and mirrors ciRunDecision", () =
     // would pass a same-answer check while restoring the cancellation bug.
     assert.equal(partition("requested", 1, CI_WORKFLOW_PATH), "active");
     assert.equal(partition("completed", 1, CI_WORKFLOW_PATH), "noop");
+
+    // THE CANARY FOR THE CLAUSE ITSELF. `workflow_run.path` was not read
+    // anywhere in this repo before these gates, nothing validates it, and every
+    // gate that consumes it gates by SKIPPING — so a payload that stops carrying
+    // the field turns the panel, the fixer and the CI report off at once, with
+    // no failed run anywhere to notice. `trigger-shape` is what makes that loud:
+    // it must fire exactly where the gate refuses on path grounds, and it must
+    // FAIL, or it is one more silent skip.
+    const canaryIf = (yml.match(/^ {2}trigger-shape:\n(?:.*\n)*? {4}if: >-\n((?: {6}.*\n)+)/m) || [])[1];
+    assert.ok(canaryIf, "the panel must keep a job that reports a refused/absent workflow_run.path");
+    const canary = new Function("ACTION", "ATTEMPT", "PATH", `return (${toJs(canaryIf)});`);
+    assert.ok(canary("requested", 1, ""), "an EMPTY path — the field vanishing — must page, not skip silently");
+    assert.ok(canary("requested", 1, ".github/workflows/pwn.yml"), "a run from another file must be reported");
+    for (const [action, attempt] of [["requested", 1], ["completed", 1], ["completed", 2]]) {
+      assert.ok(!canary(action, attempt, CI_WORKFLOW_PATH), `a real CI run (${action}/${attempt}) must not trip it`);
+    }
+    const canaryBody = yml.slice(yml.indexOf("\n  trigger-shape:"), yml.indexOf("\n  gate:"));
+    assert.match(canaryBody, /\n\s*exit 1\b/, "the canary must exit non-zero, or the silence is unchanged");
   }
 
