diff --git a/.github/workflows/agent-review-panel.yml b/.github/workflows/agent-review-panel.yml
index 5e4a30189..e2f1304ae 100644
--- a/.github/workflows/agent-review-panel.yml
+++ b/.github/workflows/agent-review-panel.yml
@@ -1492,16 +1492,38 @@ jobs:
           PR: ${{ needs.review-panel.outputs.pr }}
           REQUIRED: ${{ needs.review-panel.outputs.required_checks }}
         run: |
+          # A REDIRECT, not a pipe: `cmd | tee` would make `$?` tee's status and
+          # lose the very thing this whole block branches on. `cat` afterwards
+          # puts the report back in the step log, where it was before.
           set +e
-          node ./scripts/agent/mark-ready.mjs "$PR" --promote --require-checks "$REQUIRED"
+          node ./scripts/agent/mark-ready.mjs "$PR" --promote --require-checks "$REQUIRED" \
+            > "$RUNNER_TEMP/mark-ready.log" 2>&1
           code=$?
           set -e
-          if [ "$code" -eq 2 ]; then echo "mark-ready tooling error" >&2; exit 2; fi
-          # exit 3 = gates passed but the flip-to-ready FAILED (permission/tooling).
-          # Fail the job loudly so the stalled net pages a human — never silent.
-          if [ "$code" -eq 3 ]; then echo "Promotion failed after gates passed (see log)." >&2; exit 3; fi
-          if [ "$code" -eq 1 ]; then echo "Not all ready-gates satisfied; leaving as draft."; fi
-          if [ "$code" -eq 0 ]; then echo "ready=true" >> "$GITHUB_OUTPUT"; fi
+          cat "$RUNNER_TEMP/mark-ready.log"
+          # `case` with a `*)` default, NOT a chain of `if [ -eq N ]`. The chain
+          # had no else, so a status the script never emits — 127 from a missing
+          # binary, 128+signal from a kill — fell through every branch and the
+          # step SUCCEEDED with no output at all.
+          case "$code" in
+            0) echo "ready=true" >> "$GITHUB_OUTPUT" ;;
+            # exit 1 = a gate said no; the job succeeds and the PR stays a draft.
+            # But 1 is ALSO node's own crash code: a SyntaxError, a failed import
+            # of checks/set-state/disclosure, an unhandled rejection. Believing a
+            # bare 1 would report a crash as the benign "leaving as draft", and a
+            # PR that should have been promoted would sit as a draft forever —
+            # the precise failure the comment on this job exists to prevent. So
+            # require the script's OWN verdict on stdout before trusting the 1;
+            # `mark-ready.test.mjs` pins that string on both sides of this file.
+            1) grep -qF "Not promoting: one or more gates are not satisfied" "$RUNNER_TEMP/mark-ready.log" \
+                 || { echo "mark-ready CRASHED (exit 1, no verdict line)" >&2; exit 2; }
+               echo "Not all ready-gates satisfied; leaving as draft." ;;
+            2) echo "mark-ready tooling error" >&2; exit 2 ;;
+            # exit 3 = gates passed but the flip-to-ready FAILED (permission/tooling).
+            # Fail the job loudly so the stalled net pages a human — never silent.
+            3) echo "Promotion failed after gates passed (see log)." >&2; exit 3 ;;
+            *) echo "mark-ready returned unhandled status $code" >&2; exit 2 ;;
+          esac
 
